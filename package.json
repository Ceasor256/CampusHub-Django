{
  "name": "campushub-django-assets",
  "private": true,
  "description": "Builds static/css/app.css from assets/app.css. Only needed when changing styles.",
  "scripts": {
    "css": "tailwindcss -i assets/app.css -o static/css/app.css --minify",
    "css:watch": "tailwindcss -i assets/app.css -o static/css/app.css --watch",
    "fonts": "node -e \"const fs=require('fs');fs.copyFileSync('node_modules/@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2','static/font/plus-jakarta-sans-latin.woff2')\""
  },
  "devDependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
