{
  "name": "campushub-django-assets",
  "private": true,
  "description": "Builds static assets: CSS (assets/app.css) and the 3D scroll story (assets/story/scene.js). Only needed when changing styles or the story.",
  "scripts": {
    "css": "tailwindcss -i assets/app.css -o static/css/app.css --minify",
    "css:watch": "tailwindcss -i assets/app.css -o static/css/app.css --watch",
    "fonts": "node -e \"const fs=require('fs');fs.copyFileSync('node_modules/@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2','static/font/plus-jakarta-sans-latin.woff2')\"",
    "story": "esbuild assets/story/scene.js --bundle --minify --format=esm --target=es2020 --legal-comments=eof --outfile=static/js/story-scene.js",
    "build": "npm run css && npm run story"
  },
  "devDependencies": {
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "three": "^0.187.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
