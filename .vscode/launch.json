{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CampusHub: run server (port 8010)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}\\manage.py",
            "args": ["runserver", "8010"],
            "python": "${workspaceFolder}\\venv\\Scripts\\python.exe",
            "django": true,
            "justMyCode": true
        },
        {
            "name": "CampusHub: run tests",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}\\manage.py",
            "args": ["test", "tests"],
            "python": "${workspaceFolder}\\venv\\Scripts\\python.exe",
            "django": true
        }
    ]
}
