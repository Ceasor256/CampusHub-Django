# ---------------------------------------------------------------
# CampusHub (Django) environment configuration.
# Defaults are for local development. Never commit real secrets.
# ---------------------------------------------------------------
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
APP_URL=http://localhost:8010

# Empty = SQLite file (db.sqlite3). Production: PostgreSQL, e.g.
# DATABASE_URL=postgres://user:pass@host:5432/campushub
DATABASE_URL=

# Email. Default stores mail in the dev outbox (/dev/outbox/).
# Production: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend + the EMAIL_* settings.
EMAIL_BACKEND=core.mail.OutboxBackend
EMAIL_FROM=CampusHub <no-reply@campushub.ug>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Rate limiting cache. Set when running more than one worker.
REDIS_URL=

# Payments (Phase 2). Only "test" exists: no real money moves.
PAYMENT_PROVIDER=test
PAYMENT_WEBHOOK_SECRET=change-me
